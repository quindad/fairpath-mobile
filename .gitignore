# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase CLI local link state (contains the linked project ref; never commit)
supabase/.temp/
# Empty leftover from an abandoned CLI dump attempt; raw production dumps must never be committed
supabase/production_baseline.sql

# DEV seed: the service-role key is only ever read from the shell environment; never keep it in a file
.env.seed*
*.service-role*
