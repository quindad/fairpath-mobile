# Copy to .env.local and fill in per environment (dev vs prod point at
# different Supabase projects). Expo inlines EXPO_PUBLIC_* vars at build
# time, so these are safe to ship to the client — they're the anon /
# publishable key, not a service-role secret.
#
# If unset, src/lib/supabase.ts falls back to the current project's
# values so existing local dev keeps working unchanged.

EXPO_PUBLIC_SUPABASE_URL=https://rqpczemdagoddhuwefxt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zPBzvXj7eVASZo20n3nIOg_4JBdeug_
