# Copy to .env.local (gitignored) and fill in. Expo inlines EXPO_PUBLIC_* vars at
# bundle time, so these are safe to ship to the client — they are the anon /
# publishable key, never a service-role secret.
#
# LOCAL DEVELOPMENT MUST POINT AT THE DEV PROJECT (fairpath-mobile-dev):
#   Supabase dashboard -> fairpath-mobile-dev -> Project Settings -> API
#
# In a __DEV__ build, src/lib/supabase.ts REFUSES TO START if these are unset
# (it will not silently fall back to production), and it prints a loud error if
# they are set to the production project.

EXPO_PUBLIC_SUPABASE_URL=https://znvhmuhojvwvjzmaqwff.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<paste the fairpath-mobile-dev anon/publishable key here>

# ---- Payments (Stripe) -----------------------------------------------------------------------------
# Publishable key ONLY (pk_test_... in DEV). Safe to ship; it can only create payment methods.
# The Stripe SECRET key and webhook secret NEVER go in the app or in .env.local: they are Supabase Edge Function
# secrets (see docs/EXTERNAL_SETUP_CHECKLIST.md).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple Pay merchant id (create it in the Apple Developer account first; also set APPLE_MERCHANT_ID as an EAS env var).
EXPO_PUBLIC_APPLE_MERCHANT_ID=
# "true" once Google Pay is configured (also set ENABLE_GOOGLE_PAY=true as an EAS env var).
EXPO_PUBLIC_GOOGLE_PAY_ENABLED=
